<!DOCTYPE html>
<html>
<body>
    <h1>{{ T.Emails_Greeting }} {{ FirstName }}!</h1>
    <p>{{ T.Emails_NewMessageBodyText }}</p>
    <div class="email-body">
        <ul>
            {% for msg in Messages %}
                <li>{{ msg }}</li>
            {% endfor %}
        </ul>
    </div>
    <footer>
        <a href="{{ UnsubscribeUrl }}">{{ T.Emails_UnsubscribeTextLink }}</a>
    </footer>
</body>
</html>
