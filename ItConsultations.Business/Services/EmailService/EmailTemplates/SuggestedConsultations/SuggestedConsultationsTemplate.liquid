<!DOCTYPE html>
<html>
<body>
    <h1>{{ T.Emails_Greeting }} {{ FirstName }}!</h1>
    <p>{{ T.Emails_SuggestedConsultationsText }}</p>
    <div class="email-body">
        <ul>
            {% for consultation in SuggestedConsultations %}
                <a href={{ SuggestedConsultationUrl }}>{{ consultation }}</li>
            {% endfor %}
        </ul>
    </div>
    <footer>
        <a href="{{ UnsubscribeUrl }}">{{ T.Emails_UnsubscribeTextLink }}</a>
    </footer>
</body>
</html>
